# Local Vite/Cloudflare: copy this to .dev.vars (ignored by git).
# Next.js / Vercel: copy to .env.local locally, then configure server environment.
APP_URL=http://localhost:4173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate independent random values with: openssl rand -hex 32
SESSION_HASH_SECRET=
CRON_SECRET=
# Gemini is the default provider. Never prefix secrets VITE_/NEXT_PUBLIC_.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set AI_PROVIDER=openai to use an OpenAI Responses model instead.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_ENABLED=false
# Optional verified model prices for internal USD cost estimates, per million tokens.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
# Cashfree subscriptions, pinned API 2025-01-01. Start with sandbox keys.
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Use the signing secret for this Cashfree environment (typically its client secret).
CASHFREE_WEBHOOK_SECRET=
# Enable only after merchant approval, tax/refund disclosures and sandbox verification.
CASHFREE_LIVE_ENABLED=false
# Optional invitation emails. Without these, admins receive a one-time shareable link.
RESEND_API_KEY=
EMAIL_FROM=
# Comma-separated Supabase auth.users UUIDs. Administration also requires TOTP aal2.
PLATFORM_ADMIN_USER_IDS=

# Places API (New), server-only business profile lookup
GOOGLE_PLACES_API_KEY=

# Set only when the origin is protected by this ingress: cloudflare or vercel.
# Without a trusted proxy, anonymous requests share a conservative rate limit.
TRUSTED_PROXY=
